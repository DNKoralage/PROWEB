/* ==========================================================================
   Dark tropical / jungle aesthetic: deep green palette, dark textures,
   ========================================================================== */

/* ------------------------------------------------------------------ tokens */
:root {
  /* Core palette */
  --dk-black:      #010705;
  --dk-forest-900: #04160f;
  --dk-forest-800: #062417;
  --dk-forest-700: #08351f;
  --dk-forest-600: #0b4a2b;
  --dk-forest-500: #0f6036;
  --dk-forest-400: #137a44;

  /* Accents (overridden from the dashboard at runtime) */
  --dk-accent:   #2ef2c8;
  --dk-accent-2: #2b7fff;

  /* Text */
  --dk-ink:      #f2fff8;
  --dk-ink-soft: rgba(242, 255, 248, 0.72);
  --dk-ink-mute: rgba(242, 255, 248, 0.52);

  /* Surfaces */
  --dk-surface:   rgba(4, 22, 15, 0.72);
  --dk-surface-2: rgba(6, 36, 23, 0.85);
  --dk-line:      rgba(46, 242, 200, 0.16);
  --dk-line-strong: rgba(46, 242, 200, 0.38);

  /* Type */
  --dk-font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --dk-display: 'Clash Display', 'Inter', -apple-system, 'Segoe UI', sans-serif;

  --dk-step--1: clamp(0.78rem, 0.76rem + 0.1vw, 0.84rem);
  --dk-step-0:  clamp(0.95rem, 0.92rem + 0.15vw, 1.05rem);
  --dk-step-1:  clamp(1.1rem, 1.03rem + 0.35vw, 1.35rem);
  --dk-step-2:  clamp(1.35rem, 1.2rem + 0.75vw, 1.85rem);
  --dk-step-3:  clamp(1.7rem, 1.4rem + 1.5vw, 2.6rem);
  --dk-step-4:  clamp(2.1rem, 1.5rem + 3vw, 4rem);
  --dk-step-5:  clamp(2.6rem, 1.4rem + 5.4vw, 6rem);

  /* Rhythm */
  --dk-gutter: clamp(1.15rem, 4vw, 3.5rem);
  --dk-section-y: clamp(4.5rem, 10vw, 9rem);
  --dk-radius: 14px;
  --dk-radius-lg: 26px;
  --dk-maxw: 1320px;

  /* Motion */
  --dk-ease: cubic-bezier(0.22, 1, 0.36, 1);
  --dk-ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --dk-fast: 180ms;
  --dk-med: 420ms;
  --dk-slow: 900ms;
}

/* -------------------------------------------------------------------- base */
*, *::before, *::after { box-sizing: border-box; }

html {
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  background: var(--dk-black);
  color: var(--dk-ink);
  font-family: var(--dk-font);
  font-size: var(--dk-step-0);
  line-height: 1.65;
  letter-spacing: 0.01em;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* Dark texture: fixed grain plus a canopy tint behind everything. */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: -2;
  background:
    radial-gradient(1200px 700px at 78% -10%, rgba(19, 122, 68, 0.30), transparent 62%),
    radial-gradient(900px 600px at 8% 12%, rgba(43, 127, 255, 0.16), transparent 60%),
    linear-gradient(180deg, #04160f 0%, #010806 48%, #010504 100%);
}

body::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: 0.38;
  mix-blend-mode: overlay;
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='180' height='180'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='180' height='180' filter='url(%23n)' opacity='0.42'/%3E%3C/svg%3E");
}

img, svg, video { max-width: 100%; display: block; }
img { height: auto; }
a { color: inherit; text-decoration: none; }

button, input, textarea, select { font: inherit; color: inherit; }

/* ------------------------------------------------------------- typography */
h1, h2, h3, h4 {
  font-family: var(--dk-display);
  font-weight: 600;
  line-height: 1.06;
  letter-spacing: -0.02em;
  margin: 0 0 0.5em;
  text-wrap: balance;
}

p { margin: 0 0 1.1em; }
p:last-child { margin-bottom: 0; }

.dk-kicker {
  font-size: var(--dk-step--1);
  text-transform: uppercase;
  letter-spacing: 0.26em;
  color: var(--dk-accent);
  margin: 0 0 0.9rem;
  font-weight: 500;
}

.dk-container {
  width: min(100% - (var(--dk-gutter) * 2), var(--dk-maxw));
  margin-inline: auto;
}

.dk-section { position: relative; padding-block: var(--dk-section-y); }
.dk-section__head { max-width: 62ch; margin-bottom: clamp(2rem, 5vw, 3.5rem); }

.dk-section__title {
  font-size: var(--dk-step-4);
  background: linear-gradient(120deg, var(--dk-ink) 20%, var(--dk-accent) 130%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.dk-section__blurb { color: var(--dk-ink-soft); font-size: var(--dk-step-1); }
.dk-empty { color: var(--dk-ink-mute); font-style: italic; padding: 2rem 0; }

[data-reveal] {
  opacity: 0;
  transform: translateY(26px);
  transition: opacity 720ms var(--dk-ease), transform 720ms var(--dk-ease);
}
[data-reveal].is-revealed { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  [data-reveal] { opacity: 1; transform: none; }
}

.dk-modal-open, .dk-drawer-open { overflow: hidden; }

/* ---------------------------------------------------------------- buttons */
.dk-btn {
  --btn-bg: transparent;
  --btn-fg: var(--dk-ink);
  display: inline-flex;
  align-items: center;
  gap: 0.6em;
  padding: 0.95em 1.7em;
  border: 1px solid var(--dk-line-strong);
  border-radius: 999px;
  background: var(--btn-bg);
  color: var(--btn-fg);
  font-size: var(--dk-step-0);
  font-weight: 500;
  letter-spacing: 0.02em;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  isolation: isolate;
  transition: transform var(--dk-fast) var(--dk-ease),
              border-color var(--dk-fast) var(--dk-ease),
              color var(--dk-fast) var(--dk-ease);
}

.dk-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(120deg, var(--dk-accent), var(--dk-accent-2));
  transform: translateY(101%);
  transition: transform var(--dk-med) var(--dk-ease);
}

.dk-btn:hover, .dk-btn:focus-visible { color: #04160f; border-color: transparent; }
.dk-btn:hover::before, .dk-btn:focus-visible::before { transform: translateY(0); }
.dk-btn:active { transform: translateY(1px) scale(0.985); }

.dk-btn--primary {
  --btn-bg: linear-gradient(120deg, var(--dk-accent), var(--dk-accent-2));
  --btn-fg: #04160f;
  border-color: transparent;
  font-weight: 600;
}
.dk-btn--primary::before { background: linear-gradient(120deg, var(--dk-accent-2), var(--dk-accent)); }
.dk-btn--ghost { background: rgba(4, 22, 15, 0.45); backdrop-filter: blur(10px); }

.dk-dot {
  display: inline-block;
  width: 8px; height: 8px;
  margin-right: 0.6em;
  border-radius: 50%;
  background: var(--dk-accent);
  animation: dk-pulse 2.4s infinite;
}

@keyframes dk-pulse {
  0%   { box-shadow: 0 0 0 0 rgba(46, 242, 200, 0.55); }
  70%  { box-shadow: 0 0 0 12px rgba(46, 242, 200, 0); }
  100% { box-shadow: 0 0 0 0 rgba(46, 242, 200, 0); }
}

/* ----------------------------------------------------------------- toast */
.dk-toasts {
  position: fixed;
  right: clamp(0.8rem, 2vw, 1.6rem);
  bottom: clamp(0.8rem, 2vw, 1.6rem);
  z-index: 900;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  pointer-events: none;
}

.dk-toast {
  padding: 0.85rem 1.15rem;
  border-radius: var(--dk-radius);
  border: 1px solid var(--dk-line);
  background: var(--dk-surface-2);
  backdrop-filter: blur(14px);
  color: var(--dk-ink);
  font-size: var(--dk-step--1);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
  opacity: 0;
  transform: translateY(14px) scale(0.97);
  transition: opacity 320ms var(--dk-ease), transform 320ms var(--dk-ease);
}
.dk-toast.is-in { opacity: 1; transform: none; }
.dk-toast--success { border-color: rgba(46, 242, 200, 0.5); }
.dk-toast--error { border-color: rgba(255, 92, 92, 0.55); }

/* ----------------------------------------------------------------- cursor */
.dk-cursor-ring,
.dk-cursor-dot {
  position: fixed;
  top: 0; left: 0;
  z-index: 999;
  pointer-events: none;
  opacity: 0;
  will-change: transform;
  transition: opacity 220ms var(--dk-ease);
}
.dk-cursor-ring.is-visible, .dk-cursor-dot.is-visible { opacity: 1; }

.dk-cursor-dot {
  width: 6px; height: 6px;
  margin: -3px 0 0 -3px;
  border-radius: 50%;
  background: var(--dk-accent);
}

.dk-cursor-ring {
  display: grid;
  place-items: center;
  width: 40px; height: 40px;
  margin: -20px 0 0 -20px;
  border: 1px solid var(--dk-line-strong);
  border-radius: 50%;
  transition: width 260ms var(--dk-ease), height 260ms var(--dk-ease),
              margin 260ms var(--dk-ease), border-color 260ms var(--dk-ease),
              background 260ms var(--dk-ease), opacity 220ms var(--dk-ease);
}

.dk-cursor-ring.is-link { width: 58px; height: 58px; margin: -29px 0 0 -29px; border-color: var(--dk-accent); }
.dk-cursor-ring.is-view { width: 84px; height: 84px; margin: -42px 0 0 -42px;
                         background: rgba(46, 242, 200, 0.14); border-color: var(--dk-accent); }
.dk-cursor-ring.is-play { width: 72px; height: 72px; margin: -36px 0 0 -36px;
                         background: rgba(43, 127, 255, 0.18); border-color: var(--dk-accent-2); }
.dk-cursor-ring.is-text { width: 20px; height: 20px; margin: -10px 0 0 -10px; border-color: var(--dk-accent); }
.dk-cursor-ring.is-down { background: rgba(46, 242, 200, 0.22); }

.dk-cursor-label {
  font-size: 0.66rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--dk-ink);
  opacity: 0;
  transition: opacity 200ms var(--dk-ease);
}
.dk-cursor-ring.has-label .dk-cursor-label { opacity: 1; }

.dk-cursor-active body,
.dk-cursor-active body * { cursor: none !important; }
.dk-cursor-active input,
.dk-cursor-active textarea { cursor: text !important; }

@media (hover: none), (pointer: coarse) {
  .dk-cursor-ring, .dk-cursor-dot { display: none; }
}

/* ------------------------------------------------------------------- nav */
.dk-nav {
  position: fixed;
  inset: 0 0 auto;
  z-index: 500;
  border-bottom: 1px solid transparent;
  transition: background 400ms var(--dk-ease), border-color 400ms var(--dk-ease);
}
.dk-nav.is-stuck {
  background: rgba(1, 7, 5, 0.82);
  backdrop-filter: blur(18px) saturate(140%);
  border-bottom-color: var(--dk-line);
}

.dk-nav__inner {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 1rem;
  min-height: 78px;
}
.dk-nav__side--right { justify-self: end; }
.dk-nav__side--mid { justify-self: center; }

.dk-nav__logo {
  display: inline-flex;
  align-items: center;
  font-family: var(--dk-display);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1;
  transition: opacity 200ms var(--dk-ease), transform 200ms var(--dk-ease);
}
.dk-nav__logo:hover { opacity: 0.75; transform: translateY(-1px); }
.dk-nav__logo img { max-height: 60px; width: auto; }

.dk-nav__list {
  display: flex;
  align-items: center;
  gap: clamp(0.4rem, 1.6vw, 1.6rem);
  list-style: none;
  margin: 0;
  padding: 0;
}

.dk-nav__link {
  position: relative;
  display: inline-block;
  padding: 0.5rem 0.2rem;
  font-size: var(--dk-step--1);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dk-ink-soft);
  transition: color 220ms var(--dk-ease);
}
.dk-nav__link::after {
  content: '';
  position: absolute;
  left: 0; bottom: 0;
  width: 100%; height: 1px;
  background: linear-gradient(90deg, var(--dk-accent), var(--dk-accent-2));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 320ms var(--dk-ease);
}
.dk-nav__link:hover, .dk-nav__link.is-active { color: var(--dk-ink); }
.dk-nav__link:hover::after, .dk-nav__link.is-active::after { transform: scaleX(1); }

/* sound toggle: animated equaliser bars */
.dk-nav__sound {
  width: 42px; height: 42px;
  display: grid;
  place-items: center;
  border: 1px solid var(--dk-line);
  border-radius: 50%;
  background: rgba(4, 22, 15, 0.5);
  cursor: pointer;
  transition: border-color 220ms var(--dk-ease), background 220ms var(--dk-ease);
}
.dk-nav__sound:hover { border-color: var(--dk-line-strong); background: rgba(8, 53, 31, 0.6); }

.dk-eq { display: flex; align-items: flex-end; gap: 2.5px; height: 14px; }
.dk-eq i {
  width: 2.5px;
  height: 40%;
  border-radius: 2px;
  background: linear-gradient(var(--dk-accent), var(--dk-accent-2));
  animation: dk-eq 900ms var(--dk-ease-in-out) infinite alternate;
}
.dk-eq i:nth-child(2) { animation-delay: 120ms; height: 90%; }
.dk-eq i:nth-child(3) { animation-delay: 240ms; height: 60%; }
.dk-eq i:nth-child(4) { animation-delay: 360ms; height: 75%; }
.dk-nav__sound[aria-pressed="false"] .dk-eq i { animation-play-state: paused; height: 22%; opacity: 0.5; }

@keyframes dk-eq {
  from { transform: scaleY(0.35); }
  to   { transform: scaleY(1); }
}

/* burger + drawer */
.dk-nav__burger {
  display: none;
  width: 44px; height: 44px;
  padding: 0;
  border: 1px solid var(--dk-line);
  border-radius: 12px;
  background: rgba(4, 22, 15, 0.6);
  cursor: pointer;
  place-items: center;
  gap: 5px;
  position: absolute;
  right: var(--dk-gutter);
  top: 17px;
}
.dk-nav__burger span {
  display: block;
  width: 18px; height: 1.5px;
  background: var(--dk-ink);
  transition: transform 300ms var(--dk-ease), opacity 200ms var(--dk-ease);
}
.dk-nav.is-open .dk-nav__burger span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.dk-nav.is-open .dk-nav__burger span:nth-child(2) { opacity: 0; }
.dk-nav.is-open .dk-nav__burger span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

.dk-drawer {
  position: fixed;
  inset: 0;
  z-index: -1;

}
/* ------------------------------------------------------------------- hero */
.dk-hero {
  position: relative;
  min-height: 100svh;
  display: grid;
  place-items: center;
  padding: clamp(7rem, 14vh, 10rem) 0 clamp(4rem, 10vh, 7rem);
  overflow: hidden;
  isolation: isolate;
}

.dk-hero__backdrop { position: absolute; inset: -12% -6%; z-index: -2; }
.dk-layer { position: absolute; inset: 0; will-change: transform; pointer-events: none; }
.dk-layer svg { width: 100%; height: 100%; }

.dk-hero__scrim {
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(70% 55% at 50% 45%, transparent 0%, rgba(1, 7, 5, 0.55) 78%, rgba(1, 7, 5, 0.9) 100%),
    linear-gradient(180deg, rgba(1, 7, 5, 0.72) 0%, transparent 26%, transparent 62%, rgba(1, 7, 5, 0.92) 100%);
}

.dk-hero__inner { display: grid; justify-items: center; text-align: center; gap: 0.35rem; }

.dk-hero__eyebrow {
  font-size: var(--dk-step--1);
  text-transform: uppercase;
  letter-spacing: 0.3em;
  color: var(--dk-accent);
  margin: 0 0 0.6rem;
}

.dk-hero__logo {
  max-height: 190px;
  width: auto;
  margin-bottom: 1rem;
  filter: drop-shadow(0 14px 34px rgba(0, 0, 0, 0.6));
}

.dk-hero__title { font-size: var(--dk-step-5); margin: 0; display: grid; gap: 0.15em; letter-spacing: -0.035em; }
.dk-hero__title-main {
  background: linear-gradient(180deg, #ffffff 10%, #a9ffd9 90%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.dk-hero__title-accent {
  font-size: 0.32em;
  font-weight: 400;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--dk-accent);
  font-family: var(--dk-font);
}

.dk-hero__subtitle {
  max-width: 56ch;
  margin: 1.2rem 0 0;
  color: var(--dk-ink-soft);
  font-size: var(--dk-step-1);
}

.dk-hero__ctas { display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; margin-top: 2rem; }

.dk-hero__stats {
  display: flex;
  flex-wrap: wrap;
  gap: clamp(1.5rem, 5vw, 4rem);
  justify-content: center;
  list-style: none;
  margin: clamp(2.5rem, 6vw, 4rem) 0 0;
  padding: 0;
}
.dk-hero__stat { display: grid; gap: 0.15rem; }
.dk-hero__stat strong { font-family: var(--dk-display); font-size: var(--dk-step-2); font-weight: 600; line-height: 1; }
.dk-hero__stat span { font-size: var(--dk-step--1); letter-spacing: 0.14em; text-transform: uppercase; color: var(--dk-ink-mute); }

.dk-hero__scroll {
  position: absolute;
  bottom: clamp(1.4rem, 4vh, 2.6rem);
  left: 50%;
  transform: translateX(-50%);
  display: grid;
  justify-items: center;
  gap: 0.55rem;
  color: var(--dk-ink-mute);
  font-size: 0.66rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
}
.dk-hero__scroll-line {
  display: block;
  width: 1px; height: 52px;
  background: linear-gradient(var(--dk-accent), transparent);
  animation: dk-drop 2.2s var(--dk-ease-in-out) infinite;
}
@keyframes dk-drop {
  0%, 100% { transform: scaleY(0.4); transform-origin: top; opacity: 0.4; }
  50%      { transform: scaleY(1);   transform-origin: top; opacity: 1; }
}

/* ------------------------------------------------------------------ about */
.dk-about__inner {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: clamp(2rem, 6vw, 5rem);
  align-items: start;
}
.dk-about__skills { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 1.6rem 0; padding: 0; }
.dk-about__skills li {
  padding: 0.45rem 0.95rem;
  border: 1px solid var(--dk-line);
  border-radius: 999px;
  background: rgba(6, 36, 23, 0.45);
  font-size: var(--dk-step--1);
  color: var(--dk-ink-soft);
}
.dk-about__clients-label {
  display: block;
  font-size: var(--dk-step--1);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--dk-accent);
  margin-bottom: 0.5rem;
}
.dk-about__clients { color: var(--dk-ink-soft); }

/* --------------------------------------------------------------- filters */
.dk-filters { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: clamp(1.6rem, 4vw, 2.6rem); }
.dk-filter {
  padding: 0.5rem 1.1rem;
  border: 1px solid var(--dk-line);
  border-radius: 999px;
  background: transparent;
  color: var(--dk-ink-mute);
  font-size: var(--dk-step--1);
  letter-spacing: 0.06em;
  cursor: pointer;
  transition: all 240ms var(--dk-ease);
}
.dk-filter:hover { color: var(--dk-ink); border-color: var(--dk-line-strong); }
.dk-filter.is-active {
  background: linear-gradient(120deg, var(--dk-accent), var(--dk-accent-2));
  border-color: transparent;
  color: #04160f;
  font-weight: 600;
}

.dk-drawer {
  position: fixed;
  inset: 0;
  z-index: -1;
  display: grid;
  place-items: center;
  background: rgba(1, 7, 5, 0.96);
  backdrop-filter: blur(22px);
  opacity: 0;
  visibility: hidden;
  transition: opacity 380ms var(--dk-ease), visibility 380ms;
}
.dk-nav.is-open .dk-drawer { opacity: 1; visibility: visible; }

.dk-drawer__list {
  list-style: none;
  margin: 0; padding: 0;
  display: grid;
  gap: 0.4rem;
  text-align: center;
}
.dk-drawer__link {
  display: block;
  padding: 0.5rem 1rem;
  font-family: var(--dk-display);
  font-size: var(--dk-step-3);
  letter-spacing: -0.02em;
  color: var(--dk-ink-soft);
  transition: color 200ms var(--dk-ease), transform 300ms var(--dk-ease);
}
.dk-drawer__link:hover { color: var(--dk-accent); transform: translateX(6px); }

@media (max-width: 860px) {
  .dk-nav__inner { grid-template-columns: 1fr auto; min-height: 68px; }
  .dk-nav__side--mid, .dk-nav__side--right { display: none; }
  .dk-nav__burger { display: grid; }
}

.dk-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(120deg, var(--dk-accent), var(--dk-accent-2));
  transform: translateY(101%);
  transition: transform var(--dk-med) var(--dk-ease);
}

.dk-btn:hover, .dk-btn:focus-visible { color: #04160f; border-color: transparent; }
.dk-btn:hover::before, .dk-btn:focus-visible::before { transform: translateY(0); }
.dk-btn:active { transform: translateY(1px) scale(0.985); }

.dk-btn--primary {
  --btn-bg: linear-gradient(120deg, var(--dk-accent), var(--dk-accent-2));
  --btn-fg: #04160f;
  border-color: transparent;
  font-weight: 600;
}
.dk-btn--primary::before { background: linear-gradient(120deg, var(--dk-accent-2), var(--dk-accent)); }
.dk-btn--ghost { background: rgba(4, 22, 15, 0.45); backdrop-filter: blur(10px); }

.dk-dot {
  display: inline-block;
  width: 8px; height: 8px;
  margin-right: 0.6em;
  border-radius: 50%;
  background: var(--dk-accent);
  animation: dk-pulse 2.4s infinite;
}

@keyframes dk-pulse {
  0%   { box-shadow: 0 0 0 0 rgba(46, 242, 200, 0.55); }
  70%  { box-shadow: 0 0 0 12px rgba(46, 242, 200, 0); }
  100% { box-shadow: 0 0 0 0 rgba(46, 242, 200, 0); }
}

::selection { background: var(--dk-accent); color: #04160f; }

:focus-visible { outline: 2px solid var(--dk-accent); outline-offset: 3px; border-radius: 4px; }

* { scrollbar-width: thin; scrollbar-color: var(--dk-forest-500) transparent; }
*::-webkit-scrollbar { width: 10px; height: 10px; }
*::-webkit-scrollbar-track { background: transparent; }
*::-webkit-scrollbar-thumb {
  background: linear-gradient(var(--dk-forest-500), var(--dk-forest-700));
  border-radius: 20px;
  border: 2px solid var(--dk-black);
}

/* ------------------------------------------------------------------ cards */
.dk-grid { display: grid; gap: clamp(1rem, 2.4vw, 1.8rem); }
.dk-grid--projects { grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); }
.dk-grid--albums   { grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
.dk-grid--video    { grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr)); }
.dk-grid--posts    { grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }

.dk-card {
  position: relative;
  display: flex;
  flex-direction: column;
  border: 1px solid var(--dk-line);
  border-radius: var(--dk-radius-lg);
  background: var(--dk-surface);
  overflow: hidden;
  cursor: pointer;
  transition: transform 480ms var(--dk-ease), border-color 320ms var(--dk-ease),
              box-shadow 480ms var(--dk-ease);
  animation: dk-card-in 720ms var(--dk-ease) backwards;
  animation-delay: calc(var(--i, 0) * 55ms);
}

@keyframes dk-card-in {
  from { opacity: 0; transform: translateY(22px) scale(0.985); }
  to   { opacity: 1; transform: none; }
}

.dk-card:hover, .dk-card:focus-visible {
  transform: translateY(-6px);
  border-color: var(--dk-line-strong);
  box-shadow: 0 26px 60px rgba(0, 0, 0, 0.55);
}

.dk-card__media {
  position: relative;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: var(--dk-forest-900);
}
.dk-card__media--tall  { aspect-ratio: 4 / 5; }
.dk-card__media--short { aspect-ratio: 16 / 9; }

.dk-card__img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 800ms var(--dk-ease);
}
.dk-card:hover .dk-card__img { transform: scale(1.06); }

.dk-card__media::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(1, 7, 5, 0) 40%, rgba(1, 7, 5, 0.72));
  pointer-events: none;
}

.dk-card__badge,
.dk-card__count,
.dk-card__duration {
  position: absolute;
  z-index: 2;
  top: 0.8rem; left: 0.8rem;
  padding: 0.3rem 0.7rem;
  border-radius: 999px;
  background: rgba(1, 7, 5, 0.72);
  backdrop-filter: blur(8px);
  border: 1px solid var(--dk-line);
  font-size: 0.66rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dk-accent);
}
.dk-card__count, .dk-card__duration { left: auto; right: 0.8rem; color: var(--dk-ink-soft); }

.dk-card__play {
  position: absolute;
  z-index: 2;
  top: 50%; left: 50%;
  width: 62px; height: 62px;
  margin: -31px 0 0 -31px;
  border-radius: 50%;
  border: 1px solid var(--dk-line-strong);
  background: rgba(1, 7, 5, 0.55);
  backdrop-filter: blur(8px);
  display: grid;
  place-items: center;
  transition: transform 360ms var(--dk-ease), background 360ms var(--dk-ease);
}
.dk-card__play::before {
  content: '';
  width: 0; height: 0;
  margin-left: 4px;
  border-left: 14px solid var(--dk-accent);
  border-top: 9px solid transparent;
  border-bottom: 9px solid transparent;
}
.dk-card:hover .dk-card__play { transform: scale(1.12); background: rgba(46, 242, 200, 0.18); }

.dk-card__body { display: grid; gap: 0.5rem; padding: 1.15rem 1.3rem 1.4rem; }
.dk-card__title { font-size: var(--dk-step-1); margin: 0; }
.dk-card__desc, .dk-card__meta { color: var(--dk-ink-mute); font-size: var(--dk-step--1); margin: 0; }
.dk-card__meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
.dk-card__date { color: var(--dk-accent); font-size: var(--dk-step--1); letter-spacing: 0.14em; text-transform: uppercase; }

.dk-card__tags { display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; margin: 0; padding: 0; }
.dk-card__tags li {
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
  background: rgba(8, 53, 31, 0.6);
  border: 1px solid var(--dk-line);
  font-size: 0.64rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--dk-ink-mute);
}
.dk-card__year { font-size: var(--dk-step--1); color: var(--dk-accent-2); letter-spacing: 0.12em; }

/* ------------------------------------------------------------- logo grid */
.dk-logo-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr));
  gap: clamp(0.7rem, 1.6vw, 1.1rem);
}

.dk-logo-card {
  position: relative;
  display: grid;
  gap: 0.6rem;
  padding: 1rem;
  border: 1px solid var(--dk-line);
  border-radius: var(--dk-radius);
  background: rgba(6, 36, 23, 0.4);
  cursor: pointer;
  transition: transform 380ms var(--dk-ease), border-color 320ms var(--dk-ease),
              background 320ms var(--dk-ease);
  animation: dk-card-in 700ms var(--dk-ease) backwards;
  animation-delay: calc(var(--i, 0) * 45ms);
}
.dk-logo-card:hover, .dk-logo-card:focus-visible {
  transform: translateY(-5px);

}
/* ------------------------------------------------------------------ radio */
.dk-radio { position: relative; overflow: hidden; }

.dk-radio__aura {
  position: absolute;
  inset: -20%;
  z-index: -1;
  background:
    radial-gradient(closest-side, rgba(46, 242, 200, 0.16), transparent 70%),
    radial-gradient(closest-side at 70% 40%, rgba(43, 127, 255, 0.14), transparent 70%);
  filter: blur(30px);
  opacity: 0.7;
  transition: opacity 900ms var(--dk-ease);
}
.dk-radio.is-playing .dk-radio__aura { opacity: 1; }

.dk-radio__inner { display: grid; gap: clamp(1.6rem, 4vw, 2.6rem); }

.dk-radio__body {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
  gap: clamp(1.2rem, 3vw, 2.4rem);
  align-items: start;
}

.dk-radio__deck {
  display: grid;
  gap: 1.1rem;
  padding: clamp(1.1rem, 2.4vw, 1.8rem);
  border: 1px solid var(--dk-line);
  border-radius: var(--dk-radius-lg);
  background: var(--dk-surface);
  backdrop-filter: blur(14px);
  box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
}

.dk-radio__viz {
  position: relative;
  border-radius: var(--dk-radius);
  overflow: hidden;
  background:
    radial-gradient(120% 120% at 50% 0%, rgba(8, 53, 31, 0.85), rgba(1, 7, 5, 0.95));
  border: 1px solid var(--dk-line);
  aspect-ratio: 16 / 7;
}
.dk-radio__canvas { width: 100%; height: 100%; }

.dk-radio__badge {
  position: absolute;
  top: 0.7rem; left: 0.7rem;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.25rem 0.65rem;
  border-radius: 999px;
  background: rgba(1, 7, 5, 0.7);
  border: 1px solid var(--dk-line);
  font-size: 0.62rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--dk-ink-mute);
}
.dk-radio__badge-pulse {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: #ff5c5c;
  box-shadow: 0 0 10px #ff5c5c;
  animation: dk-pulse 2s infinite;
}
.dk-radio.is-playing .dk-radio__badge { color: var(--dk-ink); border-color: rgba(255, 92, 92, 0.4); }

.dk-radio__transport { display: grid; gap: 0.75rem; }

.dk-radio__play {
  width: 62px; height: 62px;
  border-radius: 50%;
  border: 1px solid var(--dk-line-strong);
  background: linear-gradient(120deg, rgba(46, 242, 200, 0.18), rgba(43, 127, 255, 0.18));
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: transform 240ms var(--dk-ease), box-shadow 240ms var(--dk-ease);
}
.dk-radio__play:hover { transform: scale(1.07); box-shadow: 0 0 0 8px rgba(46, 242, 200, 0.07); }

.dk-radio__play-icon {
  width: 0; height: 0;
  margin-left: 5px;
  border-left: 16px solid var(--dk-accent);
  border-top: 10px solid transparent;
  border-bottom: 10px solid transparent;
  transition: all 220ms var(--dk-ease);
}
.dk-radio.is-playing .dk-radio__play-icon {
  margin-left: 0;
  width: 14px; height: 16px;
  border: none;
  background: linear-gradient(90deg, var(--dk-accent) 0 5px, transparent 5px 9px, var(--dk-accent) 9px 14px);
}

.dk-radio__meta { display: grid; gap: 0.1rem; }
.dk-radio__now-label {
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--dk-accent);
}
.dk-radio__now-name { font-family: var(--dk-display); font-size: var(--dk-step-2); line-height: 1.1; }
.dk-radio__now-genre { font-size: var(--dk-step--1); color: var(--dk-ink-mute); }

.dk-radio__vol { display: flex; align-items: center; gap: 0.7rem; }
.dk-radio__vol-icon { font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--dk-ink-mute); }
.dk-radio__volume {
  flex: 1;
  height: 4px;
  -webkit-appearance: none;
  appearance: none;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--dk-accent), var(--dk-accent-2));
  cursor: pointer;
}
.dk-radio__volume::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 14px; height: 14px;
  border-radius: 50%;
  background: var(--dk-ink);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);

}
/* -------------------------------------------------------------- lightbox */
.dk-lightbox {
  position: fixed;
  inset: 0;
  z-index: 800;
  display: grid;
  grid-template-rows: auto 1fr auto;
  background: rgba(1, 5, 3, 0.96);
  backdrop-filter: blur(18px);
  animation: dk-fade-in 260ms var(--dk-ease);
}
@keyframes dk-fade-in { from { opacity: 0; } to { opacity: 1; } }

.dk-lightbox__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: clamp(0.9rem, 2.5vw, 1.5rem) clamp(1rem, 3vw, 2rem);
  border-bottom: 1px solid var(--dk-line);
}
.dk-lightbox__title { display: flex; align-items: baseline; gap: 0.9rem; min-width: 0; }
.dk-lightbox__title strong {
  font-family: var(--dk-display);
  font-size: var(--dk-step-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.dk-lightbox__count { font-size: var(--dk-step--1); color: var(--dk-accent); letter-spacing: 0.1em; }

.dk-lightbox__close,
.dk-videobox__close,
.dk-article__close {
  width: 44px; height: 44px;
  flex: none;
  border: 1px solid var(--dk-line);
  border-radius: 50%;
  background: rgba(6, 36, 23, 0.6);
  color: var(--dk-ink);
  font-size: 1.5rem;
  line-height: 1;
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: transform 220ms var(--dk-ease), border-color 220ms var(--dk-ease);
}
.dk-lightbox__close:hover, .dk-videobox__close:hover, .dk-article__close:hover {
  transform: rotate(90deg);
  border-color: var(--dk-line-strong);
}

.dk-lightbox__stage {
  position: relative;
  display: grid;
  place-items: center;
  padding: clamp(0.8rem, 2vw, 1.6rem);
  min-height: 0;
}
.dk-lightbox__figure { margin: 0; display: grid; gap: 0.7rem; justify-items: center; max-height: 100%; }
.dk-lightbox__img {
  max-width: 100%;
  max-height: calc(100vh - 260px);
  object-fit: contain;
  border-radius: var(--dk-radius);
  box-shadow: 0 40px 90px rgba(0, 0, 0, 0.6);
}
.dk-lightbox__caption { color: var(--dk-ink-soft); font-size: var(--dk-step--1); text-align: center; }

.dk-lightbox__nav {
  position: absolute;
  top: 50%;
  width: 54px; height: 54px;
  margin-top: -27px;
  border: 1px solid var(--dk-line);
  border-radius: 50%;
  background: rgba(4, 22, 15, 0.7);
  backdrop-filter: blur(10px);
  color: var(--dk-ink);
  font-size: 1.8rem;
  line-height: 1;
  cursor: pointer;
  transition: transform 220ms var(--dk-ease), border-color 220ms var(--dk-ease);
}
.dk-lightbox__nav--prev { left: clamp(0.5rem, 2vw, 1.5rem); }
.dk-lightbox__nav--next { right: clamp(0.5rem, 2vw, 1.5rem); }
.dk-lightbox__nav:hover { border-color: var(--dk-accent); }
.dk-lightbox__nav--prev:hover { transform: translateX(-4px); }
.dk-lightbox__nav--next:hover { transform: translateX(4px); }

.dk-lightbox__strip {
  display: flex;
  gap: 0.4rem;
  padding: 0.9rem clamp(1rem, 3vw, 2rem) 1.2rem;

}
/* ------------------------------------------------------------- video box */
.dk-videobox {
  position: fixed;
  inset: 0;
  z-index: 800;
  display: grid;
  grid-template-rows: auto 1fr auto;
  gap: 1rem;
  padding: clamp(1rem, 3vw, 2rem);
  background: rgba(1, 5, 3, 0.97);
  backdrop-filter: blur(18px);
  animation: dk-fade-in 260ms var(--dk-ease);
}
.dk-videobox__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.dk-videobox__title { display: grid; }
.dk-videobox__title strong { font-family: var(--dk-display); font-size: var(--dk-step-2); }
.dk-videobox__title span { font-size: var(--dk-step--1); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dk-accent); }

.dk-videobox__stage {
  display: grid;
  place-items: center;
  min-height: 0;
  border-radius: var(--dk-radius-lg);
  overflow: hidden;
  background: #000;
}
.dk-videobox__stage video,
.dk-videobox__stage iframe {
  width: 100%;
  height: 100%;
  max-height: calc(100vh - 220px);
  aspect-ratio: 16 / 9;
  border: 0;
  background: #000;
}
.dk-videobox__external { display: grid; gap: 1.2rem; justify-items: center; padding: 3rem 1.5rem; text-align: center; }
.dk-videobox__desc { color: var(--dk-ink-soft); max-width: 70ch; margin: 0; }

/* --------------------------------------------------------------- article */
.dk-article {
  position: fixed;
  inset: 0;
  z-index: 800;
  overflow-y: auto;
  padding: clamp(1rem, 4vw, 3rem);
  background: rgba(1, 5, 3, 0.97);
  backdrop-filter: blur(18px);
  animation: dk-fade-in 260ms var(--dk-ease);
}
.dk-article__head { position: relative; max-width: 74ch; margin: 0 auto 1.5rem; }
.dk-article__head time {
  display: block;
  font-size: var(--dk-step--1);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--dk-accent);
  margin-bottom: 0.5rem;
}
.dk-article__head h2 { font-size: var(--dk-step-3); margin: 0; }
.dk-article__close { position: absolute; top: -0.5rem; right: 0; }
.dk-article__cover { max-width: 74ch; width: 100%; border-radius: var(--dk-radius-lg); margin: 0 auto 1.6rem; }
.dk-article__body { max-width: 74ch; margin: 0 auto; color: var(--dk-ink-soft); font-size: var(--dk-step-1); line-height: 1.8; }
.dk-article__body h2, .dk-article__body h3 { color: var(--dk-ink); margin-top: 1.8em; }
.dk-article__body blockquote {
  margin: 1.5em 0;
  padding-left: 1.2em;
  border-left: 2px solid var(--dk-accent);
  color: var(--dk-ink);
}
.dk-article__body code {
  padding: 0.15em 0.4em;
  border-radius: 6px;
  background: rgba(8, 53, 31, 0.7);
  font-size: 0.9em;
}
.dk-page__body { max-width: 70ch; color: var(--dk-ink-soft); }

/* --------------------------------------------------------------- contact */
.dk-contact__inner { display: grid; gap: clamp(1.8rem, 5vw, 3rem); }
.dk-contact__links { display: grid; gap: 0.6rem; justify-items: start; }
.dk-contact__email {
  font-family: var(--dk-display);
  font-size: var(--dk-step-3);
  background: linear-gradient(120deg, var(--dk-ink), var(--dk-accent));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  transition: opacity 220ms var(--dk-ease);
}
.dk-contact__email:hover { opacity: 0.75; }
.dk-contact__phone { color: var(--dk-ink-soft); font-size: var(--dk-step-1); }
.dk-contact__location { color: var(--dk-ink-mute); font-size: var(--dk-step--1); letter-spacing: 0.12em; text-transform: uppercase; }

.dk-form { display: grid; gap: 1rem; max-width: 640px; }
.dk-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.dk-field { display: grid; gap: 0.4rem; }
.dk-field span {
  font-size: var(--dk-step--1);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--dk-ink-mute);
}
.dk-field input,
.dk-field textarea {
  width: 100%;
  padding: 0.85rem 1.05rem;
  border: 1px solid var(--dk-line);
  border-radius: var(--dk-radius);
  background: rgba(4, 22, 15, 0.6);
  color: var(--dk-ink);
  transition: border-color 240ms var(--dk-ease), background 240ms var(--dk-ease);
}
.dk-field input:focus, .dk-field textarea:focus {
  outline: none;
  border-color: var(--dk-accent);
  background: rgba(8, 53, 31, 0.5);
}
.dk-field textarea { resize: vertical; min-height: 120px; }
.dk-form__note { font-size: var(--dk-step--1); color: var(--dk-ink-mute); margin: 0; }
.dk-form__status { font-size: var(--dk-step--1); margin: 0; min-height: 1.2em; }
.dk-form__status.is-error { color: #ff8a8a; }
.dk-form__status.is-ok { color: var(--dk-accent); }

@media (max-width: 640px) { .dk-form__row { grid-template-columns: 1fr; } }

/* ----------------------------------------------------------------- footer */
.dk-footer {
  border-top: 1px solid var(--dk-line);
  padding-block: clamp(2.5rem, 6vw, 4rem);
  background: linear-gradient(180deg, transparent, rgba(4, 22, 15, 0.85));
}
.dk-footer__inner {
  display: grid;
  gap: clamp(1.4rem, 4vw, 2.4rem);
  grid-template-columns: 1fr auto;
  align-items: center;
}
.dk-footer__logo { max-height: 72px; width: auto; margin-bottom: 0.8rem; }
.dk-footer__tagline { color: var(--dk-ink-mute); font-size: var(--dk-step--1); margin: 0; letter-spacing: 0.1em; }
.dk-footer__social { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; list-style: none; margin: 0; padding: 0; }
.dk-footer__social a {
  font-size: var(--dk-step--1);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--dk-ink-mute);
  transition: color 220ms var(--dk-ease);
/* ==========================================================================
   Pre-loader: 10 second animated intro.
   Phases are driven by classes added in loader.js:
   is-active  -> fade in
   is-marking -> monogram starts drawing
   is-marked  -> monogram filled, tagline in
   is-parting -> leaves sweep apart
   is-done    -> whole overlay lifts away
   ========================================================================== */
.dk-loader {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: var(--dk-black);
  opacity: 0;
  transition: opacity 700ms var(--dk-ease);
}
.dk-loader.is-active { opacity: 1; }
.dk-loader.is-done {
  opacity: 0;
  transform: scale(1.06);
  transition: opacity 800ms var(--dk-ease), transform 800ms var(--dk-ease);
  pointer-events: none;
}

.dk-loader-bg { position: absolute; inset: -10%; }
.dk-loader-layer { position: absolute; inset: 0; will-change: transform; }
.dk-loader-layer svg { width: 100%; height: 100%; }

/* The two shutters that close over the screen, then part. */
.dk-loader-shutter {
  position: absolute;
  left: -5%; right: -5%;
  height: 52%;
  z-index: 1;
  background:
    radial-gradient(120% 100% at 50% 0%, rgba(11, 74, 43, 0.9), rgba(1, 7, 5, 0.98)),
    linear-gradient(180deg, #062417, #010705);
  box-shadow: 0 0 90px rgba(0, 0, 0, 0.9);
  transform: translateY(-100%);
  transition: transform 1400ms var(--dk-ease-in-out);
}
.dk-loader-shutter--b {
  top: 52%;
  height: 52%;
  transform: translateY(100%);
  box-shadow: 0 0 90px rgba(0, 0, 0, 0.9);
}

.dk-loader.is-marking .dk-loader-shutter--t { transform: translateY(-38%); }
.dk-loader.is-marking .dk-loader-shutter--b { transform: translateY(38%); }
.dk-loader.is-parting .dk-loader-shutter--t { transform: translateY(-102%); }
.dk-loader.is-parting .dk-loader-shutter--b { transform: translateY(102%); }

/* edge glow on the shutter opening line */
.dk-loader-shutter::after {
  content: '';
  position: absolute;
  left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--dk-accent), transparent);
  opacity: 0.75;
}
.dk-loader-shutter--t::after { bottom: 0; }
.dk-loader-shutter--b::after { top: 0; }

}
/* ---------------------------------------------------------------- centre */
.dk-loader-centre {
  position: relative;
  z-index: 2;
  display: grid;
  justify-items: center;
  gap: 1.1rem;
  padding: 0 1.5rem;
  text-align: center;
}

.dk-loader-logo { width: auto; filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.6)); }

.dk-loader-mark {
  position: relative;
  font-family: var(--dk-display);
  font-size: clamp(4.5rem, 18vw, 11rem);
  font-weight: 700;
  letter-spacing: -0.05em;
  line-height: 0.9;
  background: linear-gradient(140deg, #ffffff 10%, var(--dk-accent) 55%, var(--dk-accent-2) 110%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  filter: drop-shadow(0 0 26px rgba(46, 242, 200, 0.35));
  transform: scale(0.86);
  opacity: 0;
  transition: transform 1100ms var(--dk-ease), opacity 800ms var(--dk-ease);
}
.dk-loader.is-marking .dk-loader-mark { opacity: 1; transform: scale(1); }

/* clip-path reveal stands in for a stroke-draw on web-safe fonts */
.dk-loader-mark__text {
  display: block;
  clip-path: inset(0 100% 0 0);
  transition: clip-path 1800ms var(--dk-ease-in-out);
}
.dk-loader.is-marked .dk-loader-mark__text { clip-path: inset(0 0 0 0); }

.dk-loader-tagline {
  margin: 0;
  font-size: var(--dk-step--1);
  letter-spacing: 0.34em;
  text-transform: uppercase;
  color: var(--dk-ink-mute);
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 700ms var(--dk-ease) 200ms, transform 700ms var(--dk-ease) 200ms;
}
.dk-loader.is-marked .dk-loader-tagline { opacity: 1; transform: none; }

.dk-loader-bar {
  width: min(320px, 62vw);
  height: 2px;
  border-radius: 2px;
  background: rgba(242, 255, 248, 0.12);
  overflow: hidden;
}
.dk-loader-bar__fill {
  display: block;
  width: 100%;
  height: 100%;
  transform: scaleX(0);
  transform-origin: left;
  background: linear-gradient(90deg, var(--dk-accent), var(--dk-accent-2));
}

.dk-loader-percent {
  font-size: 0.68rem;
  letter-spacing: 0.28em;
  color: var(--dk-accent);
  font-variant-numeric: tabular-nums;
}

.dk-loader-skip {
  position: absolute;
  z-index: 3;
  right: clamp(1rem, 4vw, 2.5rem);
  bottom: clamp(1rem, 4vh, 2.5rem);
  padding: 0.6rem 1.2rem;
  border: 1px solid var(--dk-line);
  border-radius: 999px;
  background: rgba(4, 22, 15, 0.5);
  color: var(--dk-ink-mute);
  font-size: 0.68rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  cursor: pointer;
  opacity: 0;
  transition: opacity 600ms var(--dk-ease), border-color 240ms var(--dk-ease), color 240ms var(--dk-ease);
}
.dk-loader.is-marked .dk-loader-skip { opacity: 1; }
.dk-loader-skip:hover { color: var(--dk-ink); border-color: var(--dk-line-strong); }

/* Keep the page hidden until the intro hands over. */
.dk-loading body { overflow: hidden; }
}
.dk-footer__social a:hover { color: var(--dk-accent); }
.dk-footer__meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; align-items: center; }
.dk-footer__copy, .dk-footer__credit, .dk-footer__status { margin: 0; font-size: var(--dk-step--1); color: var(--dk-ink-mute); }

.dk-error { padding: 6rem 0; text-align: center; }

@media (max-width: 700px) { .dk-footer__inner { grid-template-columns: 1fr; } }
  overflow-x: auto;
  border-top: 1px solid var(--dk-line);
}
.dk-lightbox__thumb {
  flex: none;
  width: 76px; height: 56px;
  padding: 0;
  border: 1px solid transparent;
  border-radius: 8px;
  overflow: hidden;
  background: rgba(6, 36, 23, 0.6);
  cursor: pointer;
  opacity: 0.5;
  transition: opacity 240ms var(--dk-ease), border-color 240ms var(--dk-ease);
}
.dk-lightbox__thumb img { width: 100%; height: 100%; object-fit: cover; }
.dk-lightbox__thumb:hover { opacity: 0.85; }
.dk-lightbox__thumb.is-active { opacity: 1; border-color: var(--dk-accent); }
}
.dk-radio__volume::-moz-range-thumb {
  width: 14px; height: 14px;
  border: none;
  border-radius: 50%;
  background: var(--dk-ink);
}

.dk-radio__status { margin: 0; font-size: var(--dk-step--1); color: var(--dk-ink-mute); }
.dk-radio__status.is-error { color: #ff8a8a; }

.dk-radio__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0.4rem;
}
.dk-radio__station-btn {
  width: 100%;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 0.75rem;
  padding: 0.85rem 1.05rem;
  border: 1px solid var(--dk-line);
  border-radius: var(--dk-radius);
  background: rgba(6, 36, 23, 0.42);
  cursor: pointer;
  text-align: left;
  transition: border-color 240ms var(--dk-ease), background 240ms var(--dk-ease),
              transform 240ms var(--dk-ease);
}
.dk-radio__station-btn:hover { border-color: var(--dk-line-strong); transform: translateX(3px); }
.dk-radio__station-btn.is-playing {
  border-color: var(--dk-accent);
  background: rgba(46, 242, 200, 0.08);
}
.dk-radio__station-dot { width: 9px; height: 9px; border-radius: 50%; }
.dk-radio__station-name { font-weight: 500; }
.dk-radio__station-genre { font-size: var(--dk-step--1); color: var(--dk-ink-mute); }

@media (max-width: 900px) {
  .dk-radio__body { grid-template-columns: 1fr; }
}
  border-color: var(--dk-line-strong);
  background: rgba(11, 74, 43, 0.45);
}

.dk-logo-card__frame {
  aspect-ratio: 1 / 1;
  display: grid;
  place-items: center;
  padding: 14%;
  border-radius: calc(var(--dk-radius) - 4px);
  background:
    radial-gradient(circle at 30% 20%, rgba(46, 242, 200, 0.08), transparent 60%),
    linear-gradient(160deg, rgba(1, 7, 5, 0.6), rgba(8, 53, 31, 0.25));
}
.dk-logo-card__img {
  max-width: 100%;
  max-height: 100%;
  width: auto; height: auto;
  object-fit: contain;
  mix-blend-mode: screen;
  transition: transform 520ms var(--dk-ease);
}
.dk-logo-card:hover .dk-logo-card__img { transform: scale(1.08); }

.dk-logo-card__meta { display: grid; gap: 0.15rem; }
.dk-logo-card__meta .dk-card__title { font-size: var(--dk-step-0); }
.dk-card__cat { font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dk-accent); }
.dk-about__clients { color: var(--dk-ink-soft); }

.dk-about__media {
  position: relative;
  border-radius: var(--dk-radius-lg);
  overflow: hidden;
  border: 1px solid var(--dk-line);
  aspect-ratio: 4 / 5;
}
.dk-img--tall { width: 100%; height: 100%; object-fit: cover; }

@media (max-width: 820px) {
  .dk-about__inner { grid-template-columns: 1fr; }
}
